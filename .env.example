# Cultivation RPG environment configuration
# Copy this file to .env and fill in the values you need.
# .env is gitignored — never commit credentials.
#
# Every value here has a working default: `docker compose up` runs with none of
# it set.

# ─── Runtime agent ───────────────────────────────────────────────────────────
# Which LLM narrates. The engine is authoritative either way — only the prose
# differs, and the same saved world is playable under any provider.
#   anthropic | claude   Claude via the Anthropic API (needs a key)
#   ollama               local model, nothing leaves the machine
#   openai | openrouter  also supported
RUNTIME_PROVIDER=ollama

# ─── Provider credentials (set only what you use) ────────────────────────────
# When invoked without a configured key, the runtime returns status='error' with
# a clear "set <VAR>" message — it never crashes.

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=                             # optional; current default used when blank

# Ollama needs no key. Inside docker compose this resolves to the bundled
# service; running the engine on the host, use http://localhost:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:14b

# OPENAI_API_KEY=sk-...
# OPENAI_ORGANIZATION=org-...                  # optional, only if you use orgs

# OPENROUTER_API_KEY=or-...
# OPENROUTER_REFERER=https://cultivation.local # OpenRouter attribution header
# OPENROUTER_TITLE=Cultivation RPG             # OpenRouter attribution header

# ─── Storage ─────────────────────────────────────────────────────────────────
# Full path to the campaign database.
# RPG_MCP_DB_PATH=/data/cultivation.db
# Or just the directory holding rpg.db (defaults to the OS app-data dir).
# RPG_DATA_DIR=/path/to/state

# ─── Ports ───────────────────────────────────────────────────────────────────
WEB_PORT=8787
MCP_PORT=8788
OLLAMA_PORT=11434

# ─── Transport security (only relevant for TCP/WS transports) ────────────────
# Token clients must present in the Authorization header on non-loopback hosts.
# The compose `mcp` service binds 0.0.0.0 inside its network namespace; set this
# if you publish that port beyond your own machine.
# RPG_MCP_TRANSPORT_TOKEN=your-shared-secret

# ─── Testing ─────────────────────────────────────────────────────────────────
# Unlocks the audited admin_manage tool surface, which lifts content gates for
# exploratory testing. It never lets the agent fabricate state — every admin
# action is a real, logged engine mutation. Runs that use it are flagged and
# excluded from the death ledger.
ADMIN_MODE=false
